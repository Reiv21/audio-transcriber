# Hugging Face token (wymagany do pobrania modeli PyAnnote do podziału na mówców)
# Uzyskaj go z: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Konfiguracja Ollama (opcjonalnie, do poprawiania interpunkcji, formatowania i podsumowań)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

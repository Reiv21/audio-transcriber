# Hugging Face token (wymagany do pobrania modeli PyAnnote do podziału na mówców)
# Uzyskaj go z: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Konfiguracja Ollama (do poprawiania interpunkcji, podsumowań i analizy postów X)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── X Monitor – Skaner Profili ───────────────────────────────────────────────

# Przeglądarka do scrapingu (Brave lub Chromium)
BROWSER_BINARY=/opt/brave-bin/brave

# Adres zdalnego debuggera przeglądarki (remote debugging port)
DEBUGGER_ADDRESS=127.0.0.1:9222

# Katalog profilu przeglądarki (tu są zapisane sesje/cookies)
DEBUGGER_PROFILE_DIR=~/.selenium-brave

# URL otwierany przy starcie Brave (najlepiej strona X)
DEBUGGER_START_URL=https://x.com/home

# Wirtualny display Xvfb (przeglądarka w tle, bez okna)
# Zainstaluj: sudo apt install xvfb
XVFB_DISPLAY=:99

# Port serwera X Monitor
MONITOR_PORT=5002
MONITOR_HOST=127.0.0.1

# Limity scrapowania
MAX_RUNTIME_SECONDS=300
MAX_SCROLLS=120
